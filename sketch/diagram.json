{
  "version": 1,
  "author": "Serhii Cherneha",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ntc-temperature-sensor", "id": "ntc1", "top": -80, "left": 180, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 150, "left": 180, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "ntc1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ntc1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "ntc1:OUT", "esp:D34", "green", [ "v0" ] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:D35", "blue", [ "v0" ] ]
  ]
}
