[
    {"id": "flow_tab_5", "type": "tab", "label": "Lab 5: ESP32 MQTT", "disabled": false, "info": ""},
    {"id": "ui_tab_5", "type": "ui_tab", "name": "Lab 5 Dashboard", "icon": "settings", "order": 2, "disabled": false, "hidden": false},
    {"id": "ui_group_5", "type": "ui_group", "name": "ESP32 MQTT Data (Lab 5)", "tab": "ui_tab_5", "order": 1, "width": "6", "disp": true, "collapse": false},
    {"id": "mqtt_broker_1", "type": "mqtt-broker", "name": "HiveMQ Broker", "broker": "broker.hivemq.com", "port": "1883", "clientid": "", "autoConnect": true, "usetls": false, "compatmode": false, "protocolVersion": "4", "keepalive": "60", "cleansession": true, "birthTopic": "", "birthQos": "0", "birthPayload": "", "closeTopic": "", "closeQos": "0", "closePayload": "", "willTopic": "", "willQos": "0", "willPayload": ""},
    {"id": "mqtt_temp_5", "type": "mqtt in", "z": "flow_tab_5", "name": "MQTT Temp", "topic": "vntu/chernega/temperature", "qos": "2", "datatype": "auto-detect", "broker": "mqtt_broker_1", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 110, "y": 100, "wires": [["func_temp_parse_5"]]},
    {"id": "mqtt_light_5", "type": "mqtt in", "z": "flow_tab_5", "name": "MQTT Light", "topic": "vntu/chernega/light", "qos": "2", "datatype": "auto-detect", "broker": "mqtt_broker_1", "nl": false, "rap": true, "rh": 0, "inputs": 0, "x": 110, "y": 180, "wires": [["func_light_parse_5"]]},
    {"id": "func_temp_parse_5", "type": "function", "z": "flow_tab_5", "name": "Temp Parse", "func": "msg.payload = parseFloat(msg.payload);\nmsg.topic = \"temperature\";\nreturn msg;", "outputs": 1, "x": 310, "y": 100, "wires": [["ui_chart_temp_5", "join_5", "func_time_gen_5"]]},
    {"id": "func_light_parse_5", "type": "function", "z": "flow_tab_5", "name": "Light Parse", "func": "msg.payload = parseFloat(msg.payload);\nmsg.topic = \"light\";\nreturn msg;", "outputs": 1, "x": 310, "y": 180, "wires": [["ui_chart_light_5", "join_5"]]},
    {"id": "ui_chart_temp_5", "type": "ui_chart", "z": "flow_tab_5", "name": "Temp Chart", "group": "ui_group_5", "order": 1, "width": "6", "height": "4", "label": "NTC Temperature (C)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "ymin": "19", "ymax": "45", "removeOlder": "1", "removeOlderPoints": "", "removeOlderUnit": "60", "colors": ["#2ca02c"], "outputs": 1, "x": 550, "y": 60, "wires": [[]]},
    {"id": "ui_chart_light_5", "type": "ui_chart", "z": "flow_tab_5", "name": "Light Chart", "group": "ui_group_5", "order": 2, "width": "6", "height": "4", "label": "Light Level (%)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "ymin": "0", "ymax": "100", "removeOlder": "1", "removeOlderPoints": "", "removeOlderUnit": "60", "colors": ["#aec7e8"], "outputs": 1, "x": 550, "y": 220, "wires": [[]]},
    {"id": "func_time_gen_5", "type": "function", "z": "flow_tab_5", "name": "Time Gen", "func": "msg.payload = new Date().toLocaleString(\"uk-UA\", {timeZone: \"Europe/Kyiv\"});\nreturn msg;", "outputs": 1, "x": 510, "y": 280, "wires": [["ui_text_time_5"]]},
    {"id": "ui_text_time_5", "type": "ui_text", "z": "flow_tab_5", "name": "Time Display", "group": "ui_group_5", "order": 4, "width": "6", "height": "1", "label": "Last Update", "format": "{{msg.payload}}", "layout": "row-spread", "x": 700, "y": 280, "wires": []},
    {"id": "join_5", "type": "join", "z": "flow_tab_5", "name": "Join Temp/Light", "mode": "custom", "build": "object", "property": "payload", "propertyType": "msg", "key": "topic", "timer": "", "count": 2, "continueDelay": false, "x": 520, "y": 140, "wires": [["func_control_5"]]},
    {"id": "func_control_5", "type": "function", "z": "flow_tab_5", "name": "Status Control", "func": "var temp = msg.payload.temperature;\nvar light = msg.payload.light;\nvar status = context.get('status') || \"GOOD\";\n\nif (temp > 40.4 || light > 70.4) {\n    status = \"BAD\";\n} else if (temp <= 34.4 && light <= 64.4) {\n    status = \"GOOD\";\n}\n\ncontext.set('status', status);\n\nmsg.payload = status;\nmsg.background = (status === \"GOOD\") ? \"green\" : \"red\";\nreturn msg;", "outputs": 1, "x": 700, "y": 140, "wires": [["ui_button_status_5"]]},
    {"id": "ui_button_status_5", "type": "ui_button", "z": "flow_tab_5", "name": "Status Button", "group": "ui_group_5", "order": 3, "width": "6", "height": "1", "passthru": false, "label": "{{msg.payload}}", "tooltip": "", "color": "white", "bgcolor": "{{msg.background}}", "icon": "", "payload": "", "payloadType": "str", "topic": "topic", "topicType": "msg", "x": 880, "y": 140, "wires": [[]]}
]
